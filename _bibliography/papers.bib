@unpublished{kim2026regional,
  abbr={Regional},
  title={Revealing Regional Economic Sentiment Beyond National Aggregates: A News-Based Measure Using a Fine-Tuned Financial Language Model},
  author={Kim, Jongwon and Choi, Taelim and Ryu, Donghun},
  year={2026},
  note={Working Paper},
  abstract={This paper develops a high-frequency regional news sentiment index for Incheon—a metropolitan city in Korea with a distinct industrial structure—using economic news articles and a fine-tuned financial language model, KR-FinBERT. To address the limitations of conventional regional economic indicators—such as publication lags and limited timeliness—we construct a sentence-level sentiment classification framework based on 20,000 manually labeled news sentences. The BERT-based classifier substantially outperforms lexicon-based and traditional machine learning models in sentiment classification tasks. Using the predicted sentiment, we construct daily and monthly Incheon News Sentiment Index (INSI) measures and examine their empirical relevance for regional economic condition. The results show that the INSI is positively correlated with both national news sentiment indices and conventional economic sentiment indicators, exhibiting a lead of several months over regional consumer and manufacturing sentiment. Furthermore, impulse response analysis indicates that positive shocks to the INSI are associated with persistent increases in regional economic activity and prices. By focusing on Incheon as a case study, we demonstrate that region-specific sentiment indices can capture localized economic dynamics that are not reflected in national aggregates, highlighting their potential as real-time monitoring tools for regional economic conditions.},
  status={wp}
}

