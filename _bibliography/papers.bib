@unpublished{kim2026leaning,
  abbr={WP},
  bibtex_show={true},
  title={Leaning Against Vulnerability, Cleaning After Stress: Monetary Policy and Financial Instability},
  author={Kim, Jongwon and Shin, Kwanho},
  year={2026},
  note={Working Paper},
  html={https://ssrn.com/abstract=7257258},
  abstract={Examines how monetary policy internalizes financial stability considerations when macroprudential tools are institutionally constrained. Constructs meeting-level text-based measures of the Bank of Korea's financial stability sentiment from Monetary Policy Board minutes and news coverage (1999-2024) with a fine-tuned Korean RoBERTa classifier that separates financial stress from the build-up of vulnerabilities, and embeds them in GMM-estimated augmented Taylor rules. The BOK eases in response to acute stress but tightens against rising vulnerability sentiment; the tightening response emerges only after the 2011 amendment strengthening the financial stability mandate.},
  selected={true}
}

@unpublished{kim2026mandate,
  abbr={WP},
  bibtex_show={true},
  title={Financial Stability Mandate and Macroprudential Policy},
  author={Kim, Jongwon},
  year={2026},
  note={Working Paper. Job Market Paper},
  abstract={Studies how macroprudential policy responds to financial instability perceived by the central bank and whether monetary policy substitutes for macroprudential policy. Combines structural VARs and state-dependent local projections for Korea and a cross-country panel with a New Keynesian DSGE model featuring housing collateral and a capacity-constrained banking sector calibrated to Korea. Monetary policy substitutes for an inactive macroprudential authority only imperfectly; the gain from formal coordination is moderate, and information sharing between the two authorities recovers much of it without any mandate change.},
  selected={true}
}

@unpublished{kim2026genai,
  abbr={WP},
  bibtex_show={true},
  title={Generative AI, Older Workers, and Population Aging},
  author={Kim, Jongwon},
  year={2026},
  note={Working Paper},
  abstract={Asks whether workers near and past retirement age are insulated from generative AI. Using matched CPS worker flows (2017-2026) and occupational AI-exposure measures, finds that workers aged 65-74 are the only age group whose employment declines in exposed occupations; the adjustment runs through separations into retirement rather than reduced hiring, and the response sits past the Social Security pension boundary rather than before it.},
  selected={false}
}
