@unpublished{kim2026leaning,
  abbr={WP},
  title={Leaning Against Vulnerability, Cleaning After Stress: Monetary Policy and Financial Instability},
  author={Kim, Jongwon and Shin, Kwanho},
  year={2026},
  note={Working Paper},
  html={https://ssrn.com/abstract=7257258},
  abstract={This paper examines how monetary policy internalizes financial stability considerations when macroprudential tools are institutionally constrained, and whether responses differ across distinct forms of financial instability. Using Korea as an empirical setting—where the Bank of Korea (BOK) controls the policy rate while macroprudential authority is institutionally separated—we construct meeting-level text-based measures of financial stability sentiment (BOK-FSS) from Monetary Policy Board (MPB) minutes and meeting-day news coverage (1999–2024). A fine-tuned Korean RoBERTa classifier distinguishes between financial stress and the build-up of vulnerabilities, capturing policymakers' perceived risks rather than observable financial conditions alone. We embed these indices in a GMM-estimated augmented Taylor rule and uncover a systematic asymmetry: the BOK eases in response to acute financial stress ("cleaning") but tightens in response to rising vulnerability sentiment ("leaning against the wind"). Exploiting the 2011 amendment to the Bank of Korea Act—which strengthened the financial stability mandate while leaving institutional separation intact—we show that the tightening response to vulnerability sentiment is statistically insignificant before 2011 but emerges as economically and statistically significant thereafter, while the easing response to stress remains broadly unchanged. These findings suggest that, when macroprudential tools are constrained, monetary policy increasingly acts as a partial substitute—internalizing vulnerability risks that prudential instruments cannot fully address. Text-augmented Taylor rules further improve out-of-sample prediction accuracy relative to standard rules, and the text-based measures retain significance after controlling for conventional financial indicators, indicating that policymakers' perceived risks contain policy-relevant information beyond observable financial conditions.},
  selected={true},
  status={wp}
}

@unpublished{kim2026mandate,
  abbr={WP},
  title={Financial Stability Mandate and Macroprudential Policy},
  author={Kim, Jongwon},
  year={2026},
  note={Working Paper},
  abstract={Asks how macroprudential policy responds to financial instability perceived by the central bank and whether monetary policy substitutes for macroprudential policy. Combines structural VARs and state-dependent local projections for Korea, a 38-economy panel, and a New Keynesian DSGE model with housing collateral and a capacity-constrained banking sector calibrated to Korea. Stress and vulnerability shocks trigger opposite macroprudential responses; the policy rate responds more strongly to vulnerability when macroprudential policy is inactive. In the model, monetary policy is only an imperfect substitute; the gain from formal coordination is moderate, and information sharing between the two authorities recovers much of it without any mandate change.},
  selected={true},
  status={wp}
}

@unpublished{kim2026genai,
  abbr={WP},
  title={Generative AI, Older Workers, and Population Aging},
  author={Kim, Jongwon},
  year={2026},
  note={Working Paper},
  abstract={Asks whether workers near and past retirement age are insulated from generative AI. Using matched CPS worker flows (2017-2026) and occupational exposure to generative AI in a difference-in-differences design around the release of ChatGPT, finds that workers aged 65-74 are the only age group whose employment declines in exposed occupations. The adjustment runs through separations into retirement rather than reduced hiring; exploiting the Social Security full retirement age, the response appears past the pension-eligibility boundary but not before it, while the age structure of the workplace does not moderate the effect. The estimated incidence implies roughly 320,000-505,000 fewer employed 65-74 year-olds, scaling with the cohort toward its 2030 peak.},
  selected={true},
  status={wp}
}

